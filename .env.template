REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2

# Email transport: "resend" for production, "smtp" for local Mailpit
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com

# SMTP settings (used when EMAIL_TRANSPORT=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Waitlist (POST /store/waitlist)
# Cloudflare Turnstile secret key — server-side siteverify. Unset = signups fail closed (rejected).
TURNSTILE_SECRET_KEY=
# Resend Segment id to add opted-in waitlist contacts to. Create the Segment once in the
# Resend dashboard/API before this ships; without it, consent sync is skipped (logged, not fatal).
RESEND_SEGMENT_ID=

# 17track delivery tracking (free plan: 40 active trackings)
SEVENTEEN_TRACK_API_KEY=
# SEVENTEEN_TRACK_POOL_SIZE=40

