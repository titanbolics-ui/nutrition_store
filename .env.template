STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2

# Email transport: "resend" for production, "smtp" for local Mailpit
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@example.com

# SMTP settings (used when EMAIL_TRANSPORT=smtp)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# EasyPost delivery tracking. We register standalone trackers (explicit carrier,
# never auto-detected); EasyPost self-updates them and pushes tracker.updated
# webhooks to /hooks/easypost. The webhook secret verifies the HMAC signature.
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=

# Google Sheets warehouse sync (sync-orders-to-sheets + sync-tracking-from-sheets).
# Service-account key: raw JSON or base64-encoded JSON.
GOOGLE_SERVICE_ACCOUNT_KEY=
# Main warehouse sheet
SHEETS_MAIN_SPREADSHEET_ID=
SHEETS_MAIN_TAB_NAME=Sheet1
SHEETS_MAIN_LOCATION_ID=
# SHEETS_MAIN_TRACKING_BASE_URL=   # defaults to the dealer-send carrier page
# US Domestic warehouse sheet (ships via USPS)
SHEETS_US_DOMESTIC_SPREADSHEET_ID=
SHEETS_US_DOMESTIC_TAB_NAME=Sheet1
SHEETS_US_DOMESTIC_LOCATION_ID=
# SHEETS_US_DOMESTIC_TRACKING_BASE_URL=   # defaults to https://tools.usps.com/go/TrackConfirmAction?tLabels=
